{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}


    <section id="settings">

        {% if session.user.staff %}
        <p>Admin account may not be deleted and should only be edited when necessary.</p>
        {% endif %}

            <article class="form">

                <form action="/edit/{{session.user.id}}" method="POST" class="edit">

                    <h5>Username</h5>
                    <input
                        type="text"
                        value="{{session.user.username}}"
                        name="username"
                        required
                    >

                    <h5>Email Adress</h5>
                    <input
                        type="text"
                        value="{{session.user.email}}"
                        name="email"
                        required
                    >

                    <button class="form-submit">Save Changes</button>

            </article>

            <a id="logout" href="/logout">Logout</a>
            {%if not session.user.staff%}
            <a id="delete-account" href="/delete/account" onclick="return confirm('Are you sure you want to delete your account, {{session.user.username}}?')" >Delete account</a>
            {%endif%}
    </section>

{% endblock %}

