{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>{{studio.name}}</h2>

    <section id="table">

        <table id="week">
            <caption>Book a slot</caption>
            <thead>
                <th></th>
                {%for day in days%}
                    <th>{{day}}</th>
                {%endfor%}
            </thead>
            <tbody>
                {%for slot in slots%}
                    <tr class="slot-{{ slot.id }}">
                        <th>{{slot.display_name}}</th>
                        {%for day in days%}

                            {% set ns = namespace(status = "Available") %}

                            {%for booking in bookings%}

                                {%if booking.time_booked == slot.id and booking.day_booked == day%}
                                    {% set ns.status = "Booked" %}
                                {%endif%}

                            {%endfor%}

                            {% if not session.user.staff and slot.staff_only %}
                                {% set ns.status = "" %}
                            {% endif %}

                            {% if slot.id == 9 and day == "Fri" %}
                                {% set ns.status = "NO BOOKINGS" %}
                            {% endif %}

                            <td class="{{ ns.status | lower }}">
                                {{ ns.status }}
                            </td>
                        {%endfor%}
                    </tr>
                {%endfor%}
            </tbody>
 
        </table>

    </section>

{% endblock %}

