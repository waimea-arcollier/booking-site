{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>{{studio.name}}</h2>
    {%if session.logged_in%}
    <h3> Click to book a slot </h3>
    {%endif%}

    <section id="table">

        <table id="week">
            <thead>
                <th></th>
                {%for day in days%}
                    <th>{{day}}</th>
                {%endfor%}
            </thead>
            <tbody>
                {%for slot in slots%}
                    <tr class="slot-{{ slot.id }}">
                        <th>{{slot.display_name}}</th>
                        {%for day in days%}

                            {% set ns = namespace(status = "Available") %}

                            {%if session.logged_in%}
                                {% if not session.user.staff and slot.staff_only %}
                                    {% set ns.status = "" %}
                                {% endif %}
                            {%else%}
                                {% if slot.staff_only %}
                                    {% set ns.status = "" %}
                                {% endif %} 
                            {% endif %} 

                            {%for booking in bookings%}

                                {%if booking.time_booked == slot.id and booking.day_booked == day%}
                                    {%if booking.note %}
                                        {% set ns.status = booking.note %}
                                    {%else%}
                                        {% set ns.status = "Booked" %}
                                           
                                    {%endif%}
                                {%endif%}

                            {%endfor%}
                            
                            <td class="{{ ns.status | lower }}">
                                {% if ns.status == "Available" and session.logged_in %}
                                    <form action="/booking" method="POST">
                                        <input type="hidden" name="studio" value="{{ studio.id }}">
                                        <input type="hidden" name="day"    value="{{ day }}">
                                        <input type="hidden" name="slot"   value="{{ slot.id }}">
                                        <button>
                                {% endif %}

                                {{ ns.status }}
                                
                                {% if ns.status == "Available" %}
                                        </button>
                                    </form>
                                {% endif %}

                            </td>
                        {%endfor%}
                    </tr>
                {%endfor%}
            </tbody>
 
        </table>

    </section>

    {%if not session.logged_in%}
        <a href="/login">Log in to book a slot</a>
    {%endif%}

{% endblock %}

