{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}


    {%if session.logged_in%}
        {% if session.user.staff %}
                <button class = "nuke_em"> <a href="/delete/all" onclick="return confirm('Are you sure?')" class = "delete_all"> Clear All Student Bookings </a> </button>
        {% endif %}
    {% endif %}

    <section id="studios">

        {% for studio in studios %}

            <div onclick="location.href='/studio/{{studio.id}}';" style="cursor: pointer;" class="studio">

                <header>
                    <h3>{{ studio.name }}</h3>
                </header>

                <img id="studio-image" src=/static/images/{{studio.image_file}}>

            </div>

        {% else %}

            <p>Oops! this page is broken :c</p>

        {% endfor %}

    </section>

{% endblock %}

