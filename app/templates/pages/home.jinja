{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}


    {%if session.logged_in%}
        {% if session.user.staff %}
            <form method="GET" action="/delete/all">
                <button class = "nuke-em" onclick="return confirm('Are you sure?')"> Clear All <br> Student Bookings</button>
            </form>
        {% endif %}
    {% endif %}

    <section id="studios">

        {% for studio in studios %}

            <div onclick="location.href='/studio/{{studio.id}}';" style="cursor: pointer;" class="studio">

                <header>
                    <h3>{{ studio.name }}</h3>


                    {% if studio.booked %}
                        <p id="status-booked">IN USE</p>
                    {% else %}
                        <p id="status-available">OPEN</p>
                    {% endif %}
                    
                </header>

                <img id="studio-image" src=/static/images/{{studio.image_file}}>

            </div>

        {% else %}

            <p>Oops! this page is broken :c</p>

        {% endfor %}

    </section>

{% endblock %}

