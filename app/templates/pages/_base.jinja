{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>M Block Studio Booking {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        {% if session.logged_in %}
            <a href="/logout">Logout</a>
        {% else %}
            <a href="/login">Login</a>
        {% endif %} 

        <nav>
            <a href="/">Home</a>
            {% if session.logged_in %}
                 <a href="/account">Account settings</a>
                 <a href="/bookings">
                    {% if session.user.staff %}
                    Admin Bookings
                    {% else %}
                    My Bookings
                    {% endif %} 
                 </a>
            {% endif %} 
            {% if session.logged_in %}
                {% if session.user.staff %}
                    <a href="/students">Student Bookings</a>
                {% endif %} 
            {% endif %} 
            <a href="/help">Help</a>
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>
        <h2>{{ time | local | format("ddd") }} <span id="time">Time...</span></h2>
        {% block content %}
        {% endblock %}

    </main>

</body>

</html>

<script>
    function updateTime() {
        const clockElement = document.getElementById('time')
        const now = new Date()
        
        // Format the time to your local timezone format (e.g., 11:52:00 AM)
        clockElement.textContent = now.toLocaleTimeString()
    }
    
    // Run the function immediately so the clock isn't blank on load
    updateTime()
    
    // Update the clock every 1 second (1000 milliseconds)
    setInterval(updateTime, 1000)
</script>

