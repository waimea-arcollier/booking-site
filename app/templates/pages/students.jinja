{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    {%if session.logged_in%}
        {% if session.user.staff %}
        <form method="GET" action="/delete/all">
            <button class = "nuke-em" onclick="return confirm('Are you sure?')"> Clear All <br> Student Bookings</button>
        </form>
        {% endif %}
    {% endif %}

    
    {%if bookings%}

    <section id="bookings">

        {% for booking in bookings %}

            <div class="booking">

                <header>
                    <h3>{{ booking.name }}</h3>
                </header>

                <div class="booking-content">
                    <p>{{booking.display_name}}</p>
                    <p>{{booking.day_booked}}</p>
                    <p>Booked by: {{booking.email}}</p>

                </div>

                <a href="/delete/booking/{{booking.id}}" id="cancel-booking" onclick="return confirm('Are you sure you want to delete {{ booking.email }}\'s booking for {{booking.name}} on {{booking.day_booked}} for {{booking.display_name}}?')" >Cancel Booking</a>
            
            </div>

        {% endfor %}

    </section>

    {% else %}
 
      <p>No bookings yet!</p>

    {% endif %}
{% endblock %}

