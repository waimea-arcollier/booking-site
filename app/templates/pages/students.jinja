{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    {%if session.logged_in%}
        {% if session.user.staff %}
        <button class = "nuke-em" href="/delete/all" onclick="return confirm('Are you sure?')"> Clear All <br> Student Bookings</button>
        {% endif %}
    {% endif %}

    
    {%if bookings%}

    <section id="bookings">

        {% for booking in bookings %}

            <div class="booking">

                <div class="booking-content">

                    <header>
                        <h3>{{ booking.name }}</h3>
                    </header>

                    <p>{{booking.display_name}}</p>
                    <p>{{booking.day_booked}}</p>
                    <p>Booked by: {{booking.email}}</p>

                    <a href="/delete/booking/{{booking.id}}" onclick="return confirm('Are you sure you want to delete {{ booking.email }}\'s booking for {{booking.name}} on {{booking.day_booked}} for {{booking.display_name}}?')" >Cancel Booking</a>
                </div>
            
            </div>

        {% endfor %}

    </section>

    {% else %}
 
      <p>No bookings yet!</p>

    {% endif %}
{% endblock %}

