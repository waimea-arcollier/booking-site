{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

      {%if bookings%}

        <section id="bookings">

            {% for booking in bookings %}

                <div onclick="location.href='/studio/{{booking.studio_booked}}';" style="cursor: pointer;" class="booking">

                    <img id="booking-image" src=/static/images/{{booking.image_file}}>

                    <header>
                        <h3>{{ booking.name }}</h3>
                    </header>

                    <p>{{booking.display_name}}</p>
                    <p>{{booking.day_booked}}</p>
                    {%if booking.note%}
                        <p>Title: {{booking.note}}</p>
                    {% endif %}

                    <a href="/delete/booking/{{booking.id}}" onclick="return confirm('Are you sure you want to delete your booking for {{booking.name}} on {{booking.day_booked}} for {{booking.display_name}}?')" >Cancel Booking</a>

                </div>

            {% endfor %}

        </section>

      {% else %}

          <p>No bookings yet!</p>

      {% endif %}


{% endblock %}

