{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

      {%if bookings%}

        <section id="bookings">

            {% for booking in bookings %}

                <div class="booking">

                    <img id="booking-image" onclick="location.href='/studio/{{booking.studio_booked}}';" style="cursor: pointer;" src=/static/images/{{booking.image_file}}>

                        <div class="booking-header">
                        
                        <header>
                            <h3>{{ booking.name }}</h3>
                        </header>

                        </div>

                        <div class="booking-content">

                        <p>{{booking.display_name}}</p>
                        <p>{{booking.day_booked}}</p>
                        {%if booking.note%}
                            <p>Title: {{booking.note}}</p>
                        {% endif %}

                        </div>
                        <a href="/delete/booking/{{booking.id}}" id="cancel-booking" onclick="return confirm('Are you sure you want to delete your booking for {{booking.name}} on {{booking.day_booked}} for {{booking.display_name}}?')" >Cancel Booking</a>
                </div>

            {% endfor %}

        </section>

      {% else %}

          <p>No bookings yet!</p>

      {% endif %}


{% endblock %}

