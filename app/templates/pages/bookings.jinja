{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Time Placeholder</h2>

    <section id="studios">
      {%if bookings%}

          {% for booking in bookings %}

              <div onclick="location.href='/studio/{{booking.studio_booked}}';" style="cursor: pointer;" class="studio">

                  <header>
                      <h3>{{ booking.studio_booked }}</h3>
                  </header>

                  <p>{{booking.time_booked}}</p>
                  <p>{{booking.day_booked}}</p>

              </div>

          {% endfor %}

      {% else %}

          <p>No bookings yet!</p>

      {% endif %}

    </section>

{% endblock %}

