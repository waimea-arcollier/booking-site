{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Are you sure you'd like to book this slot?</h2>

    <section id="book">

      <article class="form">

        <form method="post" action="/booking/new">
        
            <label>
              Studio: {{ studio_name.name }}
              <input type = "hidden" name="studio" value="{{ studio }}">
            </label>

            <label>
              Day: {{ day }}
              <input type="hidden" name="day" value="{{ day }}">
            </label>
            
            <label>
              Timeslot: {{ slot_name.display_name }}
              <input type="hidden" name="slot" value="{{ slot }}">
            </label>

            {% if session.user.staff%}
              <label>
                Title of Booking: 
                <input name="note">
              </label>
            {%else%}
              <input type="hidden" name="note" value="">
            {% endif %}
        
            <button>Make This Booking</button>
        </form>

      </article>  

      <a href="/studio/{{studio}}">Go back</a>
            

    </section>

{% endblock %} 

